<?xml version="1.0"?>
<ruleset name="Ventrix Gutenberg Blocks (WPCS report)" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">
	<description>Full WordPress Coding Standards report. Advisory in CI until the legacy code is cleaned up.</description>

	<file>cafeto-gutenberg-blocks.php</file>
	<file>src</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.5-"/>
	<config name="minimum_wp_version" value="6.1"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ventrix-gutenberg-blocks"/>
			</property>
		</properties>
	</rule>
</ruleset>
